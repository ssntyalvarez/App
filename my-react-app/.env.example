# Copiá este archivo como .env (junto a package.json) y completá los valores.
# Nunca subas .env al repositorio.

# --- Firebase (configuración web pública; se incorpora al navegador) ---
# Firebase Console → Configuración del proyecto → Tus apps → App web (</>) → firebaseConfig
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Solo para desarrollo/pruebas locales con los emuladores de Firebase (npm run emulators).
# VITE_USE_FIREBASE_EMULATORS=true

# --- RAWG (clave PRIVADA del servidor; SIN prefijo VITE_) ---
# https://rawg.io/apidocs → Get API Key. En Vercel: Settings → Environment Variables.
RAWG_API_KEY=
