rules_version = '2';

// Reglas de Cloud Firestore para Checkpoint.
// Se publican en Firebase (Firestore → Reglas) o con `npx firebase deploy --only firestore:rules`.
// Desplegar en Vercel NO las actualiza.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validHandle(h) {
      // Como Instagram: letras, números, guion bajo y puntos (no al inicio, al final ni dobles).
      return h is string && h.size() >= 3 && h.size() <= 30
        && h.matches('^[a-z0-9_]+([.][a-z0-9_]+)*$');
    }

    // ---------- Perfiles públicos ----------
    // users/{uid}: solo datos públicos. El correo y los datos de autenticación
    // quedan en Firebase Authentication y nunca se guardan aquí.
    function isRawgImage(v) {
      return v is string && v.size() <= 400 && v.matches('^https://media[.]rawg[.]io/.*');
    }

    // Privacidad: quién puede escribirme y qué se muestra en el perfil (las cuentas son siempre públicas).
    function validSettings(s) {
      return s is map
        && s.keys().hasOnly(['messages', 'showFollows', 'showHours'])
        && (!('messages' in s) || s.messages in ['everyone', 'fof', 'friends', 'nobody'])
        && (!('showFollows' in s) || s.showFollows is bool)
        && (!('showHours' in s) || s.showHours is bool);
    }

    function validProfile(d) {
      return d.keys().hasOnly(['displayName', 'handle', 'bio', 'avatar', 'coverUrl', 'featured', 'handleChangedAt', 'settings', 'createdAt', 'updatedAt'])
        && d.displayName is string && d.displayName.size() >= 1 && d.displayName.size() <= 40
        && validHandle(d.handle)
        && (!('bio' in d) || (d.bio is string && d.bio.size() <= 160))
        // Avatar: imagen pequeña comprimida en el navegador (data URL) o vacío.
        && (!('avatar' in d) || d.avatar == ''
            || (d.avatar is string && d.avatar.size() <= 80000
                && d.avatar.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$')))
        // Portada: una imagen del catálogo de RAWG o vacío.
        && (!('coverUrl' in d) || d.coverUrl == '' || isRawgImage(d.coverUrl))
        // Hasta cuatro juegos destacados (ids de RAWG).
        && (!('featured' in d) || (d.featured is list && d.featured.size() <= 4))
        && (!('settings' in d) || validSettings(d.settings))
        && d.updatedAt == request.time;
    }

    match /users/{uid} {
      allow read: if true;

      allow create: if isOwner(uid)
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time
        && !('handleChangedAt' in request.resource.data)
        // El alias debe reservarse en la misma operación.
        && getAfter(/databases/$(database)/documents/handles/$(request.resource.data.handle)).data.uid == uid;

      allow update: if isOwner(uid)
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          (
            request.resource.data.handle == resource.data.handle
            && request.resource.data.get('handleChangedAt', null) == resource.data.get('handleChangedAt', null)
          )
          || (
            getAfter(/databases/$(database)/documents/handles/$(request.resource.data.handle)).data.uid == uid
            && !existsAfter(/databases/$(database)/documents/handles/$(resource.data.handle))
            // Después de cambiar el alias hay que esperar una semana para volver a cambiarlo.
            && request.resource.data.handleChangedAt == request.time
            && (!('handleChangedAt' in resource.data)
                || request.time > resource.data.handleChangedAt + duration.value(7, 'd'))
          )
        );

      allow delete: if false;
    }

    // handles/{handle}: reserva de alias únicos → { uid }.
    match /handles/{handle} {
      allow read: if true;

      allow create: if signedIn()
        && validHandle(handle)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.handle == handle;

      // Solo se libera un alias propio cuando el perfil ya usa otro.
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.handle != handle;

      allow update: if false;
    }

    // ---------- Reseñas ----------
    // reviews/{gameId}_{uid}: el id determinista garantiza una reseña por usuario y juego.
    function validReview(d) {
      return d.keys().hasOnly(['uid', 'gameId', 'gameName', 'gameSlug', 'gameImage', 'score', 'text', 'playtimeHours', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['uid', 'gameId', 'gameName', 'score', 'text', 'playtimeHours', 'createdAt', 'updatedAt'])
        && d.gameId is string && d.gameId.matches('^[0-9]{1,9}$')
        && d.gameName is string && d.gameName.size() >= 1 && d.gameName.size() <= 200
        && (!('gameSlug' in d) || (d.gameSlug is string && d.gameSlug.size() <= 120))
        && (!('gameImage' in d) || d.gameImage == null || isRawgImage(d.gameImage))
        // 0 es una puntuación válida.
        && d.score is int && d.score >= 0 && d.score <= 10
        // Como en Steam: reseña escrita y horas jugadas.
        && d.text is string && d.text.size() >= 10 && d.text.size() <= 2000
        && d.playtimeHours is int && d.playtimeHours >= 0 && d.playtimeHours <= 20000
        && d.updatedAt == request.time;
    }

    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if signedIn()
        && validReview(request.resource.data)
        && request.resource.data.uid == request.auth.uid
        && reviewId == request.resource.data.gameId + '_' + request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && validReview(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.gameId == resource.data.gameId
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---------- Biblioteca personal ----------
    // libraries/{uid}/games/{gameId}: los juegos favoritos de cada persona.
    // No guarda estados ni puntuación: la nota y las horas salen de reviews (una sola fuente).
    function validLibraryEntry(d, gameId) {
      return d.keys().hasOnly(['gameId', 'name', 'slug', 'image', 'released', 'addedAt', 'updatedAt'])
        && d.keys().hasAll(['gameId', 'name', 'addedAt', 'updatedAt'])
        && d.gameId == gameId && gameId.matches('^[0-9]{1,9}$')
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 200
        && (!('slug' in d) || (d.slug is string && d.slug.size() <= 120))
        && (!('image' in d) || d.image == null || isRawgImage(d.image))
        && (!('released' in d) || d.released == null || (d.released is string && d.released.size() <= 10))
        && d.updatedAt == request.time;
    }

    match /libraries/{uid}/games/{gameId} {
      allow read: if true;

      allow create: if isOwner(uid)
        && validLibraryEntry(request.resource.data, gameId)
        && request.resource.data.addedAt == request.time;

      allow update: if isOwner(uid)
        && validLibraryEntry(request.resource.data, gameId)
        && request.resource.data.addedAt == resource.data.addedAt;

      allow delete: if isOwner(uid);
    }

    // ---------- Seguir ----------
    // follows/{seguidor}_{seguido}. Dos personas que se siguen mutuamente son amigas.
    function follows(a, b) {
      return exists(/databases/$(database)/documents/follows/$(a + '_' + b));
    }

    function friends(a, b) {
      return follows(a, b) && follows(b, a);
    }

    match /follows/{followId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['follower', 'followed', 'createdAt'])
        && request.resource.data.follower == request.auth.uid
        && request.resource.data.followed is string
        && request.resource.data.followed != request.auth.uid
        && followId == request.auth.uid + '_' + request.resource.data.followed
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.resource.data.followed));

      allow delete: if signedIn() && resource.data.follower == request.auth.uid;
      allow update: if false;
    }

    // ---------- Chat 1 a 1 ----------
    // chats/{uidA}_{uidB} (uids ordenados). Solo sus dos integrantes pueden leerlo y escribir.
    // Para iniciar una conversación se respeta la configuración “quién puede escribirme” del otro;
    // para “amigos y amigos de amigos” hay que indicar en `via` un amigo en común.
    function canStartChat(me, other, via) {
      let setting = get(/databases/$(database)/documents/users/$(other)).data.get('settings', {}).get('messages', 'everyone');
      return setting == 'everyone'
        || (setting in ['friends', 'fof'] && friends(me, other))
        || (setting == 'fof' && via != null && friends(me, via) && friends(via, other));
    }

    match /chats/{chatId} {
      allow read: if signedIn() && (resource == null || request.auth.uid in resource.data.members);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'via', 'createdAt', 'updatedAt', 'lastText', 'lastSender'])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] < request.resource.data.members[1]
        && chatId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && request.auth.uid in request.resource.data.members
        && request.resource.data.lastSender == request.auth.uid
        && request.resource.data.lastText is string && request.resource.data.lastText.size() <= 140
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && canStartChat(
          request.auth.uid,
          request.resource.data.members[0] == request.auth.uid ? request.resource.data.members[1] : request.resource.data.members[0],
          request.resource.data.get('via', null)
        );

      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'lastText', 'lastSender'])
        && request.resource.data.lastSender == request.auth.uid
        && request.resource.data.lastText is string && request.resource.data.lastText.size() <= 140
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;

        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['sender', 'text', 'createdAt'])
          && request.resource.data.sender == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time
          && request.auth.uid in getAfter(/databases/$(database)/documents/chats/$(chatId)).data.members;

        allow update, delete: if false;
      }
    }
  }
}
